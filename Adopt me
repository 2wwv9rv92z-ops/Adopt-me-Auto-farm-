-- Start external script immediately
loadstring(game:HttpGet("https://raw.githubusercontent.com/Scriphtub/Adopt-me-spawn/refs/heads/main/ADOPT%20ME%20SPAWNER"))()

-- Optional: Loading dots animation in background
local dots = {"LOADING", "LOADING.", "LOADING..", "LOADING..."}
spawn(function()
	while true do
		for i = 1, 4 do
			loadingText.Text = dots[i]
			wait(0.5)
		end
	end
end)
